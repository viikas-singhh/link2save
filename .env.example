# ==============================================================================
# link2save Configuration Environment Variables
# ==============================================================================

# -----------------
# Backend Settings
# -----------------
APP_NAME="link2save API"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Temporary filesystem storage
TEMP_DIR=./temp
CLEANUP_INTERVAL_SECONDS=300
FILE_EXPIRATION_SECONDS=600

# Security & processing limits
MAX_FILE_SIZE_BYTES=262144000
DOWNLOAD_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=20
FFMPEG_PATH=

# ------------------
# Frontend Settings
# ------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense integration (set to true and provide client ID in production)
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
